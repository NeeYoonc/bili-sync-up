#!/bin/bash

set -euo pipefail

# 主程序、Chromium CDP 和登录桌面必须同时可用，才算单容器登录环境就绪。
curl --fail --silent --show-error --max-time 5 \
    http://127.0.0.1:12345/ >/dev/null

curl --fail --silent --show-error --max-time 5 \
    http://127.0.0.1:9222/json/version |
    grep --quiet '"Browser"'

# 登录桌面可选 Basic Auth。这里允许 401，只检查 HTTP 服务确实
# 已经开始响应；带凭据模式由 Docker 构建工作流另行验证。
status="$(
    curl --silent --show-error --max-time 5 \
        --output /dev/null --write-out '%{http_code}' \
        http://127.0.0.1:3000/
)"

[[ "$status" != "000" ]]
