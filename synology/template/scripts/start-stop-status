#!/bin/sh
# start-stop-status —— DSM 7 服务控制（start | stop | status | restart）
# 退出码：status 0=运行中 / 3=未运行；start/stop 非 0 = 失败（DSM 会提示）
PKG_NAME="@APP@"
PKG_DIR="/var/packages/$PKG_NAME/target"
VAR_DIR="/var/packages/$PKG_NAME/var"
PKG_USER="$PKG_NAME"
HOME_DIR="$VAR_DIR/home"
CONFIG_DIR="$VAR_DIR/config"
LOG="$VAR_DIR/bili-sync.log"
STARTLOG="$VAR_DIR/start.log"
PIDFILE="$VAR_DIR/bili-sync.pid"
PORT="$(cat "$VAR_DIR/port" 2>/dev/null)"
case "$PORT" in
  ''|*[!0-9]*) PORT=12345 ;;
esac

[ -d "$PKG_DIR" ] || { echo "未安装: $PKG_DIR 不存在"; exit 4; }

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$STARTLOG" 2>/dev/null || true; }

is_running() {
  [ -f "$PIDFILE" ] || return 1
  _pid="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$_pid" ] || return 1
  kill -0 "$_pid" 2>/dev/null
}

port_in_use() {
  netstat -ltn 2>/dev/null | grep -q ":$PORT " && return 0
  awk -v p="$(printf '%04X' "$PORT")" 'NR>1 && $2 ~ ":"p"$" {f=1} END{exit !f}' /proc/net/tcp 2>/dev/null
}

wait_port() {
  _n=0
  while [ "$_n" -lt 20 ]; do
    if netstat -ltn 2>/dev/null | grep -q ":$PORT "; then return 0; fi
    if awk -v p="$(printf '%04X' "$PORT")" 'NR>1 && $2 ~ ":"p"$" {f=1} END{exit !f}' /proc/net/tcp 2>/dev/null; then
      return 0
    fi
    sleep 1; _n=$((_n + 1))
  done
  return 1
}

# 优先以包用户运行；DSM 已把脚本降权到包用户时直接跑；su 失败则退回 root 并记录
run_as_pkg() {
  _cmd="$1"
  if [ "$(id -u)" != "0" ]; then
    log "当前用户 $(id -un)（非 root）→ 直接运行"
    sh -c "$_cmd"
    return $?
  fi
  log "以包用户 $PKG_USER 运行（su）"
  if su -s /bin/sh "$PKG_USER" -c "$_cmd" 2>>"$STARTLOG"; then
    return 0
  fi
  log "⚠ su 到 $PKG_USER 失败 → 退回 root 运行"
  sh -c "$_cmd"
}

do_start() {
  log "===== start（端口 $PORT，用户 $(id -un)）====="
  if is_running; then echo "已在运行（pid $(cat "$PIDFILE")）"; return 0; fi
  mkdir -p "$VAR_DIR" "$HOME_DIR" "$CONFIG_DIR" 2>/dev/null || true
  chown -R "$PKG_USER:$PKG_USER" "$VAR_DIR" 2>/dev/null || true
  if port_in_use; then
    log "✗ 端口 $PORT 已被其它进程占用"
    echo "端口 $PORT 已被占用，请改端口后重启（var/port 与 var/config/config.toml 的 bind_address）"
    return 1
  fi
  : > "$LOG" 2>/dev/null || true
  run_as_pkg "cd '$PKG_DIR' && HOME='$HOME_DIR' BILI_SYNC_CONFIG_DIR='$CONFIG_DIR' nohup '$PKG_DIR/bin/start.sh' >> '$LOG' 2>&1 & echo \$! > '$PIDFILE'"
  log "拉起返回码 $?"
  if wait_port; then
    log "✓ 端口 $PORT 就绪"
    echo "已启动（端口 $PORT）"
    return 0
  fi
  log "✗ 端口 $PORT 未就绪，bili-sync.log 尾部："
  tail -n 30 "$LOG" 2>/dev/null | while IFS= read -r l; do log "  $l"; done
  echo "启动失败：详见 $STARTLOG 与 $LOG"
  return 1
}

do_stop() {
  log "===== stop ====="
  if ! is_running; then rm -f "$PIDFILE"; echo "未运行"; return 0; fi
  _pid="$(cat "$PIDFILE")"
  kill "$_pid" 2>/dev/null || true
  _n=0
  while kill -0 "$_pid" 2>/dev/null; do
    _n=$((_n + 1))
    if [ "$_n" -ge 20 ]; then kill -9 "$_pid" 2>/dev/null || true; break; fi
    sleep 1
  done
  rm -f "$PIDFILE"
  echo "已停止"
  return 0
}

case "$1" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; do_start ;;
  status)
    if is_running; then echo "运行中（pid $(cat "$PIDFILE")）"; exit 0; fi
    echo "未运行"; exit 3 ;;
  *) echo "用法: $0 {start|stop|status|restart}" >&2; exit 1 ;;
esac
