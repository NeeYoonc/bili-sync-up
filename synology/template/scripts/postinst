#!/bin/sh
# postinst —— 安装/重装后：
#   1) 目录与权限
#   2) 探测已安装的 FFmpeg 套件（强依赖），得到 ffmpeg 目录
#   3) 预置应用配置（端口 / Token / ffmpeg_path）——升级/重装保留数据时绝不覆盖用户已有配置
#   4) 生成 DSM 门户 ui/config（套件中心「打开」按钮）
PKG_NAME="@APP@"
APP_ID="BiliSyncUp"
PKG_DIR="/var/packages/$PKG_NAME/target"
VAR_DIR="/var/packages/$PKG_NAME/var"
CONFIG_DIR="$VAR_DIR/config"
DB="$CONFIG_DIR/data.sqlite"

mkdir -p "$VAR_DIR/home" "$CONFIG_DIR"
chmod 755 "$PKG_DIR/bin/"* 2>/dev/null || true

WIZ_PORT="${wizard_port:-}"
WIZ_TOKEN="${wizard_token:-}"

have_sqlite=no
command -v sqlite3 >/dev/null 2>&1 && have_sqlite=yes

# ── 1) 探测 FFmpeg 套件（套件源里为 ffmpeg / ffmpeg5 / ffmpeg6 / ffmpeg7 / ffmpeg8） ──
FFMPEG_DEP="@FFMPEG_DEP@"
FF_DIR=""
for _v in 8 7 6 5 ""; do
  _d="/var/packages/ffmpeg${_v}/target/bin"
  if [ -x "$_d/ffmpeg" ]; then FF_DIR="$_d"; break; fi
done
# 兜底：符号链接在 /usr/local/bin 的情况
if [ -z "$FF_DIR" ] && command -v ffmpeg >/dev/null 2>&1; then
  FF_DIR="$(dirname "$(command -v ffmpeg)")"
fi
if [ -n "$FF_DIR" ]; then
  echo "[postinst] 检测到 FFmpeg: $FF_DIR"
else
  echo "[postinst] ⚠ 未检测到 FFmpeg 套件（依赖 $FFMPEG_DEP 应已安装）；视频合并会失败，请确认 FFmpeg 套件已启动"
fi

# ── 2) 判定全新安装 vs 升级/重装 ─────────────────────────────────────────
EXIST_DB=no
[ -f "$DB" ] && EXIST_DB=yes

# 现有端口（库已存在时）
CUR_PORT=""
if [ "$EXIST_DB" = "yes" ] && [ "$have_sqlite" = "yes" ]; then
  CUR_PORT="$(sqlite3 "$DB" "SELECT value_json FROM config_items WHERE key_name='bind_address';" 2>/dev/null \
              | tr -d '\"' | sed 's/.*://')"
  case "$CUR_PORT" in ''|*[!0-9]*) CUR_PORT="" ;; esac
fi

# 生效端口：向导填了 → 用它；库里有 → 保持；都没有 → 12345
if [ -n "$WIZ_PORT" ]; then
  PORT="$WIZ_PORT"
elif [ -n "$CUR_PORT" ]; then
  PORT="$CUR_PORT"
else
  PORT=12345
fi
case "$PORT" in ''|*[!0-9]*) PORT=12345 ;; esac
if [ "$PORT" -lt 100 ] 2>/dev/null || [ "$PORT" -gt 65535 ] 2>/dev/null; then PORT=12345; fi
printf '%s\n' "$PORT" > "$VAR_DIR/port"

# ── 3) 写应用配置 ────────────────────────────────────────────────────────
if [ "$have_sqlite" = "yes" ]; then
  if [ "$EXIST_DB" = "no" ]; then
    # 全新安装：造 legacy `config` 表，应用首启自动迁移成正式配置
    _json="{\"bind_address\":\"0.0.0.0:$PORT\""
    [ -n "$WIZ_TOKEN" ] && _json="$_json,\"auth_token\":\"$WIZ_TOKEN\""
    [ -n "$FF_DIR" ]    && _json="$_json,\"ffmpeg_path\":\"$FF_DIR\""
    _json="$_json}"
    sqlite3 "$DB" "CREATE TABLE config (data TEXT); INSERT INTO config (data) VALUES ('$_json');" >/dev/null 2>&1 \
      && echo "[postinst] 全新安装：预置端口 $PORT${FF_DIR:+ / ffmpeg_path=$FF_DIR}"
  else
    # 升级/重装：只更新向导里真的填了的项
    if [ -n "$WIZ_PORT" ]; then
      sqlite3 "$DB" "INSERT OR REPLACE INTO config_items (key_name,value_json,updated_at) VALUES ('bind_address','\"0.0.0.0:$PORT\"',datetime('now'));" >/dev/null 2>&1 || true
      echo "[postinst] 向导指定端口 → 更新为 $PORT"
    else
      echo "[postinst] 向导未填端口 → 保持现有端口 $PORT"
    fi
    if [ -n "$WIZ_TOKEN" ]; then
      sqlite3 "$DB" "INSERT OR REPLACE INTO config_items (key_name,value_json,updated_at) VALUES ('auth_token','\"$WIZ_TOKEN\"',datetime('now'));" >/dev/null 2>&1 || true
      echo "[postinst] 向导指定 Token → 已更新"
    fi
    # ffmpeg_path：仅在库中为空/缺失时写入（不覆盖用户手填）
    if [ -n "$FF_DIR" ]; then
      CUR_FF="$(sqlite3 "$DB" "SELECT value_json FROM config_items WHERE key_name='ffmpeg_path';" 2>/dev/null | tr -d '\"')"
      if [ -z "$CUR_FF" ]; then
        sqlite3 "$DB" "INSERT OR REPLACE INTO config_items (key_name,value_json,updated_at) VALUES ('ffmpeg_path','\"$FF_DIR\"',datetime('now'));" >/dev/null 2>&1 || true
        echo "[postinst] 已写入 ffmpeg_path=$FF_DIR"
      fi
    fi
  fi
fi

# ── 4) DSM 门户「打开」按钮 ──────────────────────────────────────────────
mkdir -p "$PKG_DIR/ui/images"
cat > "$PKG_DIR/ui/config" <<PORTAL
{
    ".url": {
        "SYNO.SDS.${APP_ID}.Application": {
            "type": "url",
            "icon": "images/icon_{0}.png",
            "title": "Bili Sync Up",
            "desc": "哔哩哔哩同步工具（Rust + Tokio）",
            "protocol": "http",
            "port": "${PORT}",
            "allUsers": false
        }
    }
}
PORTAL

# ── 5) 安装信息 ──────────────────────────────────────────────────────────
{
  echo "端口: $PORT"
  echo "访问: http://<NAS-IP>:$PORT"
  if [ -n "$WIZ_TOKEN" ]; then echo "Token: $WIZ_TOKEN"; else echo "Token: 沿用原有设置（本次未修改）"; fi
  if [ -n "$FF_DIR" ]; then echo "FFmpeg: $FF_DIR"; else echo "FFmpeg: 未检测到（请安装 FFmpeg 套件）"; fi
  echo "配置目录: $CONFIG_DIR"
} > "$VAR_DIR/access-info.txt"

# ── 6) 防火墙放行 ────────────────────────────────────────────────────────
if [ "${wizard_open_firewall:-yes}" = "yes" ]; then
  synofirewall --add-rule --name="$PKG_NAME" --protocol=tcp --port="$PORT" >/dev/null 2>&1 || true
fi

chown -R "$PKG_NAME:$PKG_NAME" "$VAR_DIR" 2>/dev/null || true
cat "$VAR_DIR/access-info.txt"
exit 0
